<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
		<defaultDocument>
			<files>
				<add value="index.asp" />
			</files>
		</defaultDocument>
		<rewrite>
			<rules>
				<rule name="rewrite empty url"> 
					<match url="^/?$" />
					<action type="Rewrite" url="index.asp" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
	<system.web>
		<!--<compilation debug="true" />
		<customErrors mode="RemoteOnly" >
			<error statusCode="404" redirect="/Error/404_Page_Not_Found.html" />
		</customErrors>-->
	</system.web>
</configuration>